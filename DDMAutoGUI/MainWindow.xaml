<Window 
        xmlns:CustomWindows="clr-namespace:DDMAutoGUI.CustomWindows"
        xmlns:windows="clr-namespace:DDMAutoGUI.windows"
        x:Class="DDMAutoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDMAutoGUI"
        mc:Ignorable="d"
        Title="DDM Automation Cell Manager"
        Height="750"
        Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FF98A4C1">

    <Grid Margin="4">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <StackPanel Orientation="Vertical">

                <Border 
                    x:Name="Warning_MsgBarBdr"
                    Visibility="Collapsed"
                    Style="{StaticResource WarningBar}"
                    Margin="0,0,0,4">

                    <TextBlock x:Name="Warning_MsgTxb" Text="Warning Message"/>
                </Border>
                <Border 
                    x:Name="Alert_MsgBarBdr"
                    Visibility="Collapsed"
                    Style="{StaticResource AlertBar}"
                    Margin="0,0,0,4">

                    <TextBlock x:Name="Alert_MsgTxb" Text="Alert Message"/>
                </Border>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="2">

            <TabControl x:Name="MainTabControl" TabStripPlacement="Left" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Connect" Tag="/Resources/icons/tree.ico" Style="{StaticResource MainTab}">

                    <Grid Margin="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="275"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <StackPanel Orientation="Vertical">
                                <GroupBox Header="Controller IP Address">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" 
                                                 x:Name="Con_IPTxt" 
                                                 Text="{Binding ControllerIpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" 
                                                x:Name="Con_ConnectBtn" 
                                                Content="Connect" 
                                                Width="110"
                                                Command="{Binding ConnectCommand}"
                                                CommandParameter="{Binding Text, ElementName=Con_IPTxt}"
                                                Style="{StaticResource BlueButton}"/>
                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                                     x:Name="Con_ConnectPrg" 
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Connection Log">

                                    <TextBox x:Name="Con_LogTxt" 
                                            Text="{Binding ConnectionLog, Mode=OneWay}"
                                             Height="250"
                                             IsReadOnly="True"
                                             VerticalScrollBarVisibility="Disabled"
                                            Style="{StaticResource MonoTextBox}"/>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </Grid>

                </TabItem>
                <TabItem x:Name="DispTab" Header="Operate" Tag="/Resources/icons/fluid.ico" Style="{StaticResource MainTab}" IsEnabled="False">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="6">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="500"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Grid Grid.Row="1" Grid.Column="1">
                                <TabControl x:Name="dispTabControl" Grid.Row="1" SelectedIndex="{Binding SelectedDispenseTabIndex}">

                                    <TabItem Header="1: Configure">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Grid x:Name="tabContainer1">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>

                                                    <GroupBox Header="Motor SN" Grid.Row="0" Grid.Column="0">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBox x:Name="Disp_MotorSNTxt" 
                                                                     Height="42" 
                                                                     Text="{Binding MotorSerialNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                    </GroupBox>

                                                    <GroupBox Header="Motor Size" Grid.Row="1" Grid.Column="0">
                                                        <StackPanel Orientation="Vertical">
                                                            <RadioButton Content="DDM 57"       GroupName="Disp_MotorSizeRdg" x:Name="Disp_Motor57"      IsEnabled="False" Checked="MotorSizeRadio_Checked" Tag="ddm_57"/>
                                                            <RadioButton Content="DDM 95"       GroupName="Disp_MotorSizeRdg" x:Name="Disp_Motor95"      IsEnabled="False" Checked="MotorSizeRadio_Checked" Tag="ddm_95"/>
                                                            <RadioButton Content="DDM 116"      GroupName="Disp_MotorSizeRdg" x:Name="Disp_Motor116"     IsEnabled="True"  Checked="MotorSizeRadio_Checked" Tag="ddm_116" IsChecked="True"/>
                                                            <RadioButton Content="DDM 170"      GroupName="Disp_MotorSizeRdg" x:Name="Disp_Motor170"     IsEnabled="False" Checked="MotorSizeRadio_Checked" Tag="ddm_170"/>
                                                            <RadioButton Content="DDM 170 Tall" GroupName="Disp_MotorSizeRdg" x:Name="Disp_Motor170Tall" IsEnabled="False" Checked="MotorSizeRadio_Checked" Tag="ddm_170_tall"/>
                                                        </StackPanel>
                                                    </GroupBox>

                                                    <GroupBox Header="Warning" Grid.Row="2" Grid.Column="0" Style="{StaticResource WarningBox}" x:Name="Disp_Warning_CalibBox" Visibility="Collapsed">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock TextWrapping="Wrap" Text="Calibration for selected motor size has expired. Please run calibration before dispensing."/>
                                                        </StackPanel>
                                                    </GroupBox>

                                                    <Button 
                                                        Grid.Row="3"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        x:Name="Disp_BeginBtn"
                                                        Content="Execute Cycle"
                                                        Command="{Binding StartDispenseCommand}"
                                                        Style="{DynamicResource BlueButton}" 
                                                        Height="70"/>


                                                    <StackPanel Orientation="Vertical" Grid.Row="4" Grid.Column="0">

                                                        <GroupBox Header="Warning: No SN" Style="{StaticResource WarningBox}"
                                                                  Visibility="{Binding IsSerialNumberMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Vertical">
                                                                <TextBlock TextWrapping="Wrap" Text="Please enter the serial number for the ring."/>
                                                            </StackPanel>
                                                        </GroupBox>
                                                        <GroupBox Header="Warning: Calibration Timeout" Style="{StaticResource WarningBox}"
                                                                  Visibility="{Binding IsCalibrationExpired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Vertical">
                                                                <TextBlock TextWrapping="Wrap" Text="Flow calibration has expired. Please recalibrate."/>
                                                            </StackPanel>
                                                        </GroupBox>
                                                    </StackPanel>

                                                </Grid>


                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="2: Monitor">
                                        <Grid x:Name="tabContainer2">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="400"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <GroupBox Header="Process Log" Grid.Row="0">

                                                    <TextBox x:Name="Disp_LogTxt" 
                                                             Text="{Binding ProcessLog, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource MonoTextBox}"/>
                                                </GroupBox>
                                                <GroupBox Header="Progress" Grid.Row="1">
                                                    <StackPanel Orientation="Vertical">
                                                        <!-- label for current step... maybe not necessary -->
                                                        <TextBlock x:Name="Disp_StepTxb"
                                                                   Visibility="Collapsed"
                                                                   Text="{Binding CurrentStep, Mode=OneWay}"
                                                                   Margin="3,0,3,3"/>
                                                        <ProgressBar
                                                            x:Name="Disp_ProcessPrg"
                                                            Value="{Binding ProcessProgress, Mode=OneWay}"
                                                            Style="{StaticResource ProgressMain}"/>
                                                        <ProgressBar 
                                                            x:Name="Disp_BusyPrg"
                                                            IsIndeterminate="True"
                                                            Visibility="{Binding IsDispenseProcessRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Style="{StaticResource ProgressMainBusy}"
                                                            Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </GroupBox>
                                            </Grid>



                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="3. Review">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Grid x:Name="tabContainer3">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <GroupBox Grid.Row="0" Header="Result" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Vertical">
                                                                <Border x:Name="Disp_Res_PassBdr" Grid.Column="0" Visibility="{Binding IsResultPass, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PassBorder}">
                                                                    <TextBlock Text="Pass" Foreground="White"/>
                                                                </Border>
                                                                <Border x:Name="Disp_Res_FailBdr" Grid.Column="0" Visibility="{Binding IsResultFail, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource FailBorder}">
                                                                    <TextBlock Text="Fail" Foreground="White"/>
                                                                </Border>
                                                                <Border x:Name="Disp_Res_IncompleteBdr" Grid.Column="0" Visibility="{Binding IsResultIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource IncompleteBorder}">
                                                                    <TextBlock Text="Incomplete" Foreground="#666"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock x:Name="Disp_Res_ResMessageTxb"
                                                                       Grid.Column="1"
                                                                       Margin="10,0,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="Black"
                                                                       VerticalAlignment="Top"
                                                                       Text="{Binding ResultMessage}"/>
                                                        </Grid>
                                                    </GroupBox>
                                                    <GroupBox Grid.Row="2" Header="Result Details" Padding="10">
                                                        <Grid>
                                                            <Grid.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                                                    <Setter Property="Foreground" Value="Black"/>
                                                                </Style>
                                                            </Grid.Resources>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Tool SN"/>
                                                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Ring SN"/>
                                                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Dispense volume ID"/>
                                                            <TextBlock Grid.Column="0" Grid.Row="3" Text="Dispense volume OD"/>
                                                            <!--<TextBlock Grid.Column="0" Grid.Row="4" Text="Flow autocalibration" Visibility="Collapsed"/>-->

                                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding ResultToolSerial}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ResultRingSerial}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ResultDispenseVolumeId}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding ResultDispenseVolumeOd}"/>
                                                            <!--<TextBlock Grid.Column="1" Grid.Row="4" Text="-" x:Name="Disp_Res_FlowCalTxb" Visibility="Collapsed"/>-->

                                                            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" Orientation="Vertical" HorizontalAlignment="Right">
                                                                <Button
                                                                    Content="View Details" 
                                                                    Click="Disp_Res_ViewResBtn_Click" 
                                                                    Style="{StaticResource SmallButton}" 
                                                                    Visibility="Visible"/>
                                                                <Button 
                                                                    Content="Open Folder" 
                                                                    Click="Disp_Res_OpenFileBtn_Click"  
                                                                    Style="{StaticResource SmallButton}" 
                                                                    Visibility="Visible"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </GroupBox>
                                                    <StackPanel Grid.Row="3" Orientation="Vertical">
                                                        <Button x:Name="Disp_Res_FinishBtn" 
                                                                Content="Finish" 
                                                                Height="50"
                                                                Click="Disp_Res_FinishBtn_Click" 
                                                                Style="{DynamicResource BlueButton}"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>

                                </TabControl>

                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="CalibTab" Header="Calibrate" Tag="/Resources/icons/centerpoint.ico" Style="{StaticResource MainTab}" IsEnabled="False">

                    <Grid>

                        <Border x:Name="Calib_PWEntryBdr" Background="WhiteSmoke" Margin="6" Visibility="Visible">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Password" Grid.Row="1" Grid.Column="1">
                                    <StackPanel Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="Calib_PWBox" 
                                                         Grid.Column="0"
                                                         Padding="6"
                                                         KeyDown="Calib_PWBox_KeyDown"/>
                                            <Button x:Name="Calib_PWSubmitBtn"
                                                    Grid.Column="1"
                                                    Padding="12,0"
                                                    Content="Submit" 
                                                    Style="{StaticResource SmallButton}" 
                                                    Click="Calib_PWSubmitBtn_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="Calib_PWMessageTxb" Text="Incorrect password" Margin="3" Visibility="Collapsed"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </Border>

                        <Grid Margin="6" Background="WhiteSmoke" x:Name="Calib_Grid" Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CustomWindows:CalibPanel Grid.Row="1" Grid.Column="1" x:Name="CalPanel"/>

                        </Grid>
                    </Grid>

                </TabItem>
                <TabItem x:Name="ServTab" Header="Maintenance" Tag="/Resources/icons/wrench.ico" Style="{StaticResource MainTab}" IsEnabled="False">


                    <Grid>

                        <Border x:Name="Serv_PWEntryBdr" Background="WhiteSmoke" Margin="6" Visibility="Visible">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Password" Grid.Row="1" Grid.Column="1">
                                    <StackPanel Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="Serv_PWBox" 
                                                         Grid.Column="0"
                                                         Padding="6"
                                                         KeyDown="Serv_PWBox_KeyDown"/>
                                            <Button x:Name="Serv_PWSubmitBtn"
                                                    Grid.Column="1"
                                                    Padding="12,0"
                                                    Content="Submit" 
                                                    Style="{StaticResource SmallButton}" 
                                                    Click="Serv_PWSubmitBtn_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="Serv_PWMessageTxb" Text="Incorrect password" Margin="3" Visibility="Collapsed"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </Border>

                        <Grid Margin="6" Background="WhiteSmoke" x:Name="Serv_Grid" Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CustomWindows:ServicePanel Grid.Row="1" Grid.Column="1"/>

                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="AboutTab" Header="About" Tag="/Resources/icons/infocircle.ico" Style="{StaticResource MainTab}" Visibility="Collapsed">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/resources/logos/b.ico" Width="50" VerticalAlignment="Top" Margin="0,6,0,0"/>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" 
                                       Content="DDM Automation Cell Manager" 
                                       Padding="0" 
                                       Foreground="{StaticResource BrooksBlue}" 
                                       FontSize="18"
                                       />

                                <TextBlock Grid.Row="1"
                                           Name="Adv_Abt_InfoTxb" 
                                           Text="{Binding AppTitle, Mode=OneWay}"
                                           Padding="0" 
                                           TextWrapping="Wrap" 
                                           Foreground="{StaticResource BrooksBlue}" 
                                           FontSize="10" VerticalAlignment="Top"/>


                            </Grid>
                        </Grid>
                    </Grid>

                </TabItem>
                <TabItem x:Name="AdvTab" Header="Dev" Tag="/Resources/icons/settings.ico" Style="{StaticResource MainTab}" Visibility="Visible">

                    <Grid Margin="-2">

                        <Border x:Name="Adv_PWEntryBdr" Background="WhiteSmoke" Margin="6" Visibility="Hidden">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Password" Grid.Row="1" Grid.Column="1">
                                    <StackPanel Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="Adv_PWBox" 
                                                     Grid.Column="0"
                                                     Padding="6"
                                                     KeyDown="Adv_PWBox_KeyDown"/>
                                            <Button x:Name="Adv_PWSubmitBtn"
                                                Grid.Column="1"
                                                Padding="12,0"
                                                Content="Submit" 
                                                Style="{StaticResource SmallButton}" 
                                                Click="Adv_PWSubmitBtn_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="Adv_PWMessageTxb" Text="Incorrect password" Margin="3" Visibility="Collapsed"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </Border>


                        <TabControl x:Name="Adv_AllControlsTcl" Visibility="Visible" TabStripPlacement="Top" Margin="6"  Background="WhiteSmoke">

                            <TabItem Header="Options">
                                <StackPanel Orientation="Vertical" Margin="6">
                                    <!--<GroupBox Header="Connection" HorizontalAlignment="Left" Padding="12">
                                        <StackPanel Orientation="Vertical">
                                            <CheckBox x:Name="Adv_Opt_Con_ControllerChk" Content="Controller"     IsChecked="{Binding ConnectController}"/>
                                            <CheckBox x:Name="Adv_Opt_Con_IOLinkChk"     Content="IO Link Devices" IsChecked="{Binding ConnectIoLinkDevices}"/>
                                            <CheckBox x:Name="Adv_Opt_Con_TopCamChk"     Content="Top Camera"     IsChecked="{Binding ConnectTopCamera}"/>
                                            <CheckBox x:Name="Adv_Opt_Con_SideCamChk"    Content="Side Camera"    IsChecked="{Binding ConnectSideCamera}"/>
                                            <CheckBox x:Name="Adv_Opt_Con_LaserChk"      Content="Laser Sensor"   IsChecked="{Binding ConnectLaserSensor}"/>
                                            <CheckBox Visibility="Collapsed" x:Name="Adv_Opt_Con_DAQChk" Content="DAQ Device" IsChecked="{Binding ConnectDaqDevice}"/>
                                        </StackPanel>
                                    </GroupBox>-->
                                    <GroupBox Header="Dispense" HorizontalAlignment="Left" Padding="12">
                                        <StackPanel Orientation="Vertical">
                                            <!--<CheckBox x:Name="Adv_Opt_Disp_HealthChk"       Content="Check Health"             IsChecked="{Binding DispCheckHealth}"/>-->
                                            <CheckBox x:Name="Adv_Opt_Disp_TopPhotoChk"     Content="Photo Top"                IsChecked="{Binding DispPhotoTop}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_SidePhotoChk"    Content="Photo Side"               IsChecked="{Binding DispPhotoSide}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_RunOCRChk"       Content="Run OCR"                  IsChecked="{Binding DispRunOCR}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_MagPolChk"       Content="Measure Polarity"         IsChecked="{Binding DispCheckPolarity}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_RingHeightChk"   Content="Measure Heights"          IsChecked="{Binding DispMeasureHeights}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_DispChk"         Content="Dispense"                 IsChecked="{Binding DispDispense}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_AutoCalibChk"    Content="Autocalibrate"            IsChecked="{Binding DispAutocalibrate}"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_TopPhotoAfterChk" Content="Photo Top After"         IsChecked="{Binding DispPhotoTopAfter}"/>
                                            <!--<CheckBox x:Name="Adv_Opt_Disp_OverrideChk"     Content="Override Dispense Warnings" IsChecked="{Binding DispOverrideWarnings}" Foreground="{StaticResource PrimaryOrange}"/>-->
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Other" HorizontalAlignment="Left" Padding="12">
                                        <StackPanel Orientation="Vertical">
                                            <CheckBox x:Name="Adv_Opt_Disp_Force57Chk" Content="Force DDM 57 Available" IsChecked="False" Checked="Adv_Opt_Disp_Force57Chk_Checked" Unchecked="Adv_Opt_Disp_Force57Chk_Unchecked"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_Force95Chk" Content="Force DDM 95 Available" IsChecked="False" Checked="Adv_Opt_Disp_Force95Chk_Checked" Unchecked="Adv_Opt_Disp_Force95Chk_Unchecked"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_Force116Chk" Content="Force DDM 116 Available" IsChecked="False" Checked="Adv_Opt_Disp_Force116Chk_Checked" Unchecked="Adv_Opt_Disp_Force116Chk_Unchecked"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_Force170Chk" Content="Force DDM 170 Available" IsChecked="False" Checked="Adv_Opt_Disp_Force170Chk_Checked" Unchecked="Adv_Opt_Disp_Force170Chk_Unchecked"/>
                                            <CheckBox x:Name="Adv_Opt_Disp_Force170TChk" Content="Force DDM 170 Tall Available" IsChecked="False" Checked="Adv_Opt_Disp_Force170TChk_Checked" Unchecked="Adv_Opt_Disp_Force170TChk_Unchecked"/>
                                        </StackPanel>
                                    </GroupBox>

                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Cell Control Panel">

                                <CustomWindows:DevCellControlPanel x:Name="CellControlPanel"/>

                            </TabItem>

                            <TabItem Header="TCS Connection">

                                <CustomWindows:DevTcsConnectionPanel />

                            </TabItem>
                            <TabItem Header="Vision">

                                <CustomWindows:DevVisionPanel />

                            </TabItem>
                            <TabItem Header="Settings">

                                <CustomWindows:SettingsPanel />

                            </TabItem>
                            <TabItem Header="Local Data">

                                <CustomWindows:LocalDataPanel />

                            </TabItem>
                            <TabItem Header="DAQ" Visibility="Collapsed">
                                <StackPanel Orientation="Vertical" Margin="6">
                                    <TextBlock x:Name="Adv_DAQ_A0Txb" Text="-" />
                                    <Button x:Name="Adv_DAQ_GetA0Btn" Click="Adv_DAQ_GetA0Btn_Click" Content="Get A0 Voltage" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                                    <Button x:Name="Adv_DAQ_GetA0TimedBtn" Click="Adv_DAQ_GetA0TimedBtn_Click" Content="Get A0 Many Voltages" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                                    <Button x:Name="Adv_Misc_TestMatlabBtn" Click="Adv_Misc_TestMatlabBtn_Click" Content="Run Matlab program to collect hall data " Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>

                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Misc" Visibility="Collapsed">
                                <StackPanel Orientation="Vertical" Margin="6">
                                    <Button x:Name="Adv_Res_OpenFolderBtn" Command="{Binding OpenResultsFolderCommand}" Content="Open Results Folder" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                                    <Button x:Name="Adv_Misc_LockAdvBtn" Command="{Binding LockAdvancedTabCommand}" Content="Lock Advanced Tab" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                    </Grid>

                </TabItem>

            </TabControl>
        </Grid>

        <Grid Grid.Row="2">
        </Grid>

        <Grid Grid.Row="3" Style="{StaticResource StatusBarBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Padding="8,4,4,4" Grid.Column="0">
                <StackPanel Orientation="Horizontal">

                    <Grid Margin="0,0,12,0">
                        <Button x:Name="Dev_Btn"
                                Click="Dev_Btn_Click"
                                Padding="4"
                                Margin="0"
                                Style="{StaticResource SmallDevIconButton}">
                            <Image Source="/Resources/icons/settings.ico" Height="20" Opacity="0.75"/>
                        </Button>
                    </Grid>
                    <Grid Margin="0,0,12,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Status: "/>
                            <TextBlock x:Name="Status_StatusTxt" Text="{Binding ConnectionStatus, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,12,0" x:Name="Status_TCSGrd" Visibility="Collapsed">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="TCS: "/>
                            <TextBlock x:Name="Status_TCSTxt" Text="-"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,12,0" x:Name="Status_PACGrd" Visibility="Collapsed">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="PAC: "/>
                            <TextBlock x:Name="Status_PACTxt" Text="-"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Padding="4" Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="Status_SimBdr" Style="{StaticResource SimBorder}" Visibility="Visible">
                        <TextBlock Text="TCS sim enabled"/>
                    </Border>
                    <Border x:Name="Status_GUISimBdr" Style="{StaticResource SimBorder}" Visibility="Visible" Margin="4,0,0,0">
                        <TextBlock Text="GUI sim enabled"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
