<UserControl x:Class="DDMAutoGUI.CustomWindows.CalibFlowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDMAutoGUI.CustomWindows"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="450">
    <Grid Background="White">
        <StackPanel Orientation="Vertical">

            <GroupBox Header="Calibrate Flow">

                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ComboBox x:Name="MotorSizeCmb" 
                                    Width="100"
                                  Height="40"
                                    VerticalAlignment="Center" 
                                    ItemsSource="{Binding MotorSizes}"
                                    SelectedIndex="{Binding SelectedFlowCalibSizeIndex, Mode=TwoWay}"
                                    SelectionChanged="MotorSizeCmb_OnSelectionChanged">
                        </ComboBox>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0">
                        <Button x:Name="RunBtn"
                        Click="RunBtn_Click"
                        Style="{StaticResource BlackButton}"
                        Content="Calibrate flow rate"
                        Margin="0"/>
                        <ProgressBar x:Name="RunPrg"/>
                    </StackPanel>
                </Grid>

            </GroupBox>

            <GroupBox Header="Last Calibration Result">

                <Grid Margin="4">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Last calibration date"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last calibration motor type"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="" x:Name="Calib_LastCalTxb"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="" x:Name="Calib_LastMotorTxb"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="System 1 Result"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="System 2 Result"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Visual Confirmation"/>


                </Grid>
            </GroupBox>

            <!--<TabControl Margin="4">
                <TabItem Header="DDM 57">
                    <local:CalibFlowSizePanel x:Name="Calib_57Panel"  MotorName="ddm_57" DisplayName="DDM 57"/>
                </TabItem>
                <TabItem Header="DDM 95">
                    <local:CalibFlowSizePanel x:Name="Calib_95Panel"  MotorName="ddm_95" DisplayName="DDM 95"/>
                </TabItem>
                <TabItem Header="DDM 116" IsSelected="True">
                    <local:CalibFlowSizePanel x:Name="Calib_116Panel"  MotorName="ddm_116" DisplayName="DDM 116"/>
                </TabItem>

                <TabItem Header="DDM 170">
                    <local:CalibFlowSizePanel x:Name="Calib_170Panel"  MotorName="ddm_170" DisplayName="DDM 170"/>
                </TabItem>
                <TabItem Header="DDM 170 Tall">
                    <local:CalibFlowSizePanel x:Name="Calib_170TallPanel"  MotorName="ddm_170_tall" DisplayName="DDM 170 Tall"/>
                </TabItem>
            </TabControl>-->


        </StackPanel>

    </Grid>
</UserControl>
