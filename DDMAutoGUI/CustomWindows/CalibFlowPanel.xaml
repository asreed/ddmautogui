<UserControl x:Class="DDMAutoGUI.CustomWindows.CalibFlowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDMAutoGUI.CustomWindows"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="450">
    <Grid>
        <StackPanel Orientation="Vertical">
            <Grid Margin="4" Background="WHite">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <!--<Setter Property="Background" Value="WhiteSmoke"/>-->
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Last calibrated"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Last size"/>


                <TextBlock Grid.Row="0" Grid.Column="1" Text="" x:Name="Calib_LastCalTxb"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="" x:Name="Calib_LastMotorTxb"/>

            </Grid>

            <TabControl Margin="4">
                <TabItem Header="DDM 57">
                    <local:CalibFlowSizePanel x:Name="Calib_57Panel"  MotorName="ddm_57" DisplayName="DDM 57"/>
                </TabItem>
                <TabItem Header="DDM 95">
                    <local:CalibFlowSizePanel x:Name="Calib_95Panel"  MotorName="ddm_95" DisplayName="DDM 95"/>
                </TabItem>
                <TabItem Header="DDM 116" IsSelected="True">
                    <local:CalibFlowSizePanel x:Name="Calib_116Panel"  MotorName="ddm_116" DisplayName="DDM 116"/>
                </TabItem>

                <TabItem Header="DDM 170">
                    <local:CalibFlowSizePanel x:Name="Calib_170Panel"  MotorName="ddm_170" DisplayName="DDM 170"/>
                </TabItem>
                <TabItem Header="DDM 170 Tall">
                    <local:CalibFlowSizePanel x:Name="Calib_170TallPanel"  MotorName="ddm_170_tall" DisplayName="DDM 170 Tall"/>
                </TabItem>
            </TabControl>


        </StackPanel>

    </Grid>
</UserControl>
