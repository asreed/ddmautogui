<UserControl x:Class="DDMAutoGUI.CustomWindows.DevTcsConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDMAutoGUI.CustomWindows"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Height="Auto" Header="TCS Connection">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBox Grid.Column="0" Grid.Row="0" x:Name="Adv_Con_IPTxt" Text="192.168.0.1" Style="{StaticResource SmallTextBox}"/>
                <Button Grid.Column="1" Grid.Row="0" x:Name="Adv_Con_ConnectBtn" Content="Connect to TCS"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"
                        Click="Adv_Con_ConnectBtn_Click" Style="{StaticResource SmallButton}"/>
                <Button Grid.Column="2" Grid.Row="0" x:Name="Adv_Con_DisconnectBtn" Content="Disconnect from TCS"
                        IsEnabled="{Binding IsConnected}"
                        Click="Adv_Con_DisconnectBtn_Click" Style="{StaticResource SmallButton}"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                    <Label Content="Controller software version:"/>
                    <Label x:Name="Adv_Con_ContVersionTxt" Content="(no version info)"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Status Connection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="1" x:Name="Adv_Con_StatusLogTxt"
                             Text="{Binding StatusLog, Mode=OneWay}"
                             TextChanged="Adv_Con_StatusLogTxt_TextChanged"
                             Margin="4"
                             Style="{StaticResource MonoTextBox}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="Adv_Con_StatusMsgTxt" Text="" KeyDown="Adv_Con_StatusLogTxt_KeyDown" Style="{StaticResource SmallTextBox}"/>
                        <Button Grid.Column="1" x:Name="Adv_Con_StatusSendBtn" Content="Send"
                                IsEnabled="{Binding IsConnected}"
                                Click="Adv_Con_StatusSendBtn_Click" Style="{StaticResource SmallButton}"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Robot Connection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" x:Name="Adv_Con_RobotLogTxt"
                             Text="{Binding RobotLog, Mode=OneWay}"
                             TextChanged="Adv_Con_RobotLogTxt_TextChanged"
                             Margin="4"
                             Style="{StaticResource MonoTextBox}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="Adv_Con_RobotMsgTxt" Text="" KeyDown="Adv_Con_RobotLogTxt_KeyDown" Style="{StaticResource SmallTextBox}"/>
                        <Button Grid.Column="1" x:Name="Adv_Con_RobotSendBtn" Content="Send"
                                IsEnabled="{Binding IsRobotControlEnabled}"
                                Click="Adv_Con_RobotSendBtn_Click" Style="{StaticResource SmallButton}"/>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>