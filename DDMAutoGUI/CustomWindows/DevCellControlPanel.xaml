<UserControl x:Class="DDMAutoGUI.CustomWindows.DevCellControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDMAutoGUI.CustomWindows"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="System State" Grid.Column="0">
            <TabControl>
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>

                            <Grid.Resources>
                                <Style TargetType="Label">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Header="System"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="System pressure:"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Content="{Binding SysPressure}" 
                                           ContentStringFormat="{}{0:F1} psi"
                                           Style="{StaticResource ReadoutLabel}"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Robot"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Power enabled:"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource ReadoutLabel}"
                                           Content="{Binding IsPowerEnabled, Converter={StaticResource BoolToYesNoConverter}}">
                                        <Label.Background>
                                            <MultiBinding Converter="{StaticResource ReadoutBackgroundConverter}">
                                                <Binding Path="IsPowerEnabled"/>
                                                <Binding Path="ReadoutsEnabled"/>
                                            </MultiBinding>
                                        </Label.Background>
                                    </Label>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Robot homed:"/>
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource ReadoutLabel}"
                                           Content="{Binding IsRobotHomed, Converter={StaticResource BoolToYesNoConverter}}">
                                        <Label.Background>
                                            <MultiBinding Converter="{StaticResource ReadoutBackgroundConverter}">
                                                <Binding Path="IsRobotHomed"/>
                                                <Binding Path="ReadoutsEnabled"/>
                                            </MultiBinding>
                                        </Label.Background>
                                    </Label>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Linear position:"/>
                                    <Label Grid.Row="2" Grid.Column="1" 
                                           Content="{Binding LinearPosition}" 
                                           ContentStringFormat="{}{0:F3} mm"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Rotary position:"/>
                                    <Label Grid.Row="3" Grid.Column="1" 
                                           Content="{Binding RotaryPosition}" 
                                           ContentStringFormat="{}{0:F3} deg"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="4" Grid.Column="0" Content="Rail flags:"/>
                                    <Grid Grid.Row="4" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0"
                                               Style="{StaticResource ReadoutLabel}"
                                               Content="{Binding LinearFlag1, Converter={StaticResource BoolToYesNoConverter}}">
                                            <Label.Background>
                                                <MultiBinding Converter="{StaticResource ReadoutBackgroundConverter}">
                                                    <Binding Path="LinearFlag1"/>
                                                    <Binding Path="ReadoutsEnabled"/>
                                                </MultiBinding>
                                            </Label.Background>
                                        </Label>
                                        <Label Grid.Column="1"
                                               Style="{StaticResource ReadoutLabel}"
                                               Content="{Binding LinearFlag2, Converter={StaticResource BoolToYesNoConverter}}">
                                            <Label.Background>
                                                <MultiBinding Converter="{StaticResource ReadoutBackgroundConverter}">
                                                    <Binding Path="LinearFlag2"/>
                                                    <Binding Path="ReadoutsEnabled"/>
                                                </MultiBinding>
                                            </Label.Background>
                                        </Label>
                                        <Label Grid.Column="2"
                                               Style="{StaticResource ReadoutLabel}"
                                               Content="{Binding LinearFlag3, Converter={StaticResource BoolToYesNoConverter}}">
                                            <Label.Background>
                                                <MultiBinding Converter="{StaticResource ReadoutBackgroundConverter}">
                                                    <Binding Path="LinearFlag3"/>
                                                    <Binding Path="ReadoutsEnabled"/>
                                                </MultiBinding>
                                            </Label.Background>
                                        </Label>
                                    </Grid>

                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Dispense System 1 (ID)"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Pressure command:"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Content="{Binding PressureCommand1}"
                                           ContentStringFormat="{}{0:F1} psi"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Pressure measurement:"/>
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Content="{Binding PressureMeasurement1}"
                                           ContentStringFormat="{}{0:F1} psi"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Flow volume:"/>
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Content="{Binding FlowVolume1}"
                                           ContentStringFormat="{}{0:F3} mL"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Flow error:"/>
                                    <Label Grid.Row="3" Grid.Column="1"
                                           Content="{Binding FlowError1}"
                                           Style="{StaticResource ReadoutLabel}"/>

                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Dispense System 2 (OD)"  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Pressure command:"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Content="{Binding PressureCommand2}"
                                           ContentStringFormat="{}{0:F1} psi"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Pressure measurement:"/>
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Content="{Binding PressureMeasurement2}"
                                           ContentStringFormat="{}{0:F1} psi"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Flow volume:"/>
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Content="{Binding FlowVolume2}"
                                           ContentStringFormat="{}{0:F3} mL"
                                           Style="{StaticResource ReadoutLabel}"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Flow error:"/>
                                    <Label Grid.Row="3" Grid.Column="1"
                                           Content="{Binding FlowError2}"
                                           Style="{StaticResource ReadoutLabel}"/>

                                </Grid>
                            </GroupBox>

                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Safety">
                    <Grid>

                        <Grid.Resources>
                            <Style TargetType="Label">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Robot"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Safety controller state:"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Content="{Binding SafetyControllerState}"
                                       Style="{StaticResource ReadoutLabel}"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Safety error state:"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       Content="{Binding SafetyErrorState}"
                                       Style="{StaticResource ReadoutLabel}"/>

                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

            </TabControl>
        </GroupBox>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Motor Settings" >
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="Adv_Cell_MotorSizeCmb" 
                              VerticalAlignment="Center" 
                              ItemsSource="{Binding MotorSizes}"
                              SelectedIndex="{Binding SelectedMotorSizeIndex, Mode=TwoWay}"
                              SelectionChanged="Adv_Cell_MotorSizeCmb_OnSelectionChanged">
                    </ComboBox>
                    <Button x:Name="Adv_Cell_ReloadSettingsBtn" Content="Reload" Click="Adv_Cell_ReloadSettingsBtn_Click" Style="{StaticResource SmallButton}" VerticalAlignment="Top" Height="26" Margin="12,0,0,0" Padding="8,0"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Robot Thread Commands" Grid.Row="1">
                <TabControl Grid.Row="1">

                    <TabItem Header="Robot">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">

                                <GroupBox Header="Pendant">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Grid.Column="1" x:Name="Adv_Cell_EnableBtn" Content="Enable power" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_EnableBtn_Click" />
                                        <Label  Grid.Row="0" Grid.Column="2" x:Name="Adv_Cell_EnableOutLbl" Content="-"/>

                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Movement">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Label  Grid.Row="0" Grid.Column="0" x:Name="Adv_Cell_MoveLoadInLbl" Content="-"/>
                                        <Button Grid.Row="0" Grid.Column="1" x:Name="Adv_Cell_MoveLoadBtn" Content="Move, load" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveLoadBtn_Click"/>
                                        <Label  Grid.Row="0" Grid.Column="2" x:Name="Adv_Cell_MoveLoadOutLbl" Content="-"/>

                                        <Label  Grid.Row="1" Grid.Column="0" x:Name="Adv_Cell_MoveCamTopInLbl" Content="-"/>
                                        <Button Grid.Row="1" Grid.Column="1" x:Name="Adv_Cell_MoveCamTopBtn" Content="Move, camera top" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveCamTopBtn_Click"/>
                                        <Label  Grid.Row="1" Grid.Column="2" x:Name="Adv_Cell_MoveCamTopOutLbl" Content="-"/>

                                        <Label  Grid.Row="2" Grid.Column="0" x:Name="Adv_Cell_MoveCamSideInLbl" Content="-"/>
                                        <Button Grid.Row="2" Grid.Column="1" x:Name="Adv_Cell_MoveCamSideBtn" Content="Move, camera side" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveCamSideBtn_Click"/>
                                        <Label  Grid.Row="2" Grid.Column="2" x:Name="Adv_Cell_MoveCamSideOutLbl" Content="-"/>

                                        <Label  Grid.Row="3" Grid.Column="0" x:Name="Adv_Cell_MoveLaserRingInLbl" Content="-"/>
                                        <Button Grid.Row="3" Grid.Column="1" x:Name="Adv_Cell_MoveLaserRingBtn" Content="Move, laser ring" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveLaserRingBtn_Click"/>
                                        <Label  Grid.Row="3" Grid.Column="2" x:Name="Adv_Cell_MoveLaserRingOutLbl" Content="-"/>

                                        <Label  Grid.Row="4" Grid.Column="0" x:Name="Adv_Cell_MoveLaserMagInLbl" Content="-"/>
                                        <Button Grid.Row="4" Grid.Column="1" x:Name="Adv_Cell_MoveLaserMagBtn" Content="Move, laser mag/conc" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveLaserMagBtn_Click"/>
                                        <Label  Grid.Row="4" Grid.Column="2" x:Name="Adv_Cell_MoveLaserMagOutLbl" Content="-"/>

                                        <Label  Grid.Row="5" Grid.Column="0" x:Name="Adv_Cell_MoveDispIDInLbl" Content="-"/>
                                        <Button Grid.Row="5" Grid.Column="1" x:Name="Adv_Cell_MoveDispIDBtn" Content="Move, dispense ID" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveDispIDBtn_Click"/>
                                        <Label  Grid.Row="5" Grid.Column="2" x:Name="Adv_Cell_MoveDispIDOutLbl" Content="-"/>

                                        <Label  Grid.Row="6" Grid.Column="0" x:Name="Adv_Cell_MoveDispODInLbl" Content="-"/>
                                        <Button Grid.Row="6" Grid.Column="1" x:Name="Adv_Cell_MoveDispODBtn" Content="Move, dispense OD" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveDispODBtn_Click"/>
                                        <Label  Grid.Row="6" Grid.Column="2" x:Name="Adv_Cell_MoveDispODOutLbl" Content="-"/>

                                        <Label  Grid.Row="7" Grid.Column="0" x:Name="Adv_Cell_MoveHallInLbl" Content="-"/>
                                        <Button Grid.Row="7" Grid.Column="1" x:Name="Adv_Cell_MoveHallBtn" Content="Move, hall" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_MoveHallBtn_Click"/>
                                        <Label  Grid.Row="7" Grid.Column="2" x:Name="Adv_Cell_MoveHallOutLbl" Content="-"/>

                                    </Grid>
                                </GroupBox>

                            </StackPanel>
                        </ScrollViewer>

                    </TabItem>

                    <TabItem Header="Height Sensor" Visibility="Visible">


                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">

                                <GroupBox Header="Measurements">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>


                                        <Label  Grid.Row="0" Grid.Column="0" x:Name="Adv_Cell_MeasureRingInLbl" Content="-"/>
                                        <Button Grid.Row="0" Grid.Column="1" x:Name="Adv_Cell_MeasureRingBtn" Content="Measure ring" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_MeasureRingBtn_Click"/>
                                        <Label  Grid.Row="0" Grid.Column="2" x:Name="Adv_Cell_MeasureRingOutLbl" Content="-"/>

                                        <Label  Grid.Row="1" Grid.Column="0" x:Name="Adv_Cell_MeasureMagInLbl" Content="-"/>
                                        <Button Grid.Row="1" Grid.Column="1" x:Name="Adv_Cell_MeasureMagBtn" Content="Measure mag and conc" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_MeasureMagBtn_Click"/>
                                        <Label  Grid.Row="1" Grid.Column="2" x:Name="Adv_Cell_MeasureMagOutLbl" Content="-"/>

                                        <Button Grid.Row="2" Grid.Column="1" x:Name="Adv_Cell_ShowRingBtn" Content="Show ring data" Style="{DynamicResource SmallButton}" Click="Adv_Cell_ShowRingBtn_Click"/>

                                        <Button Grid.Row="3" Grid.Column="1" x:Name="Adv_Cell_ShowMagBtn" Content="Show mag and conc data" Style="{DynamicResource SmallButton}" Click="Adv_Cell_ShowMagBtn_Click"/>

                                        <Label  Grid.Row="4" Grid.Column="0" x:Name="Adv_Cell_MeasureSingleInLbl" Content="-"/>
                                        <Button Grid.Row="4" Grid.Column="1" x:Name="Adv_Cell_MeasureSingleBtn" Content="Single measurement" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_MeasureSingleBtn_Click"/>
                                        <Label  Grid.Row="4" Grid.Column="2" x:Name="Adv_Cell_MeasureSingleOutLbl" Content="-"/>

                                    </Grid>
                                </GroupBox>



                            </StackPanel>
                        </ScrollViewer>

                    </TabItem>

                    <TabItem Header="Dispense Setup">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">

                                <GroupBox Header="Pressure Regulators">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBox Grid.Row="0" Grid.Column="0" x:Name="Adv_Cell_SetPres1InTxt" Text="10.0" Style="{StaticResource SmallTextBox}"/>
                                        <Button  Grid.Row="0" Grid.Column="1" x:Name="Adv_Cell_SetPres1Btn" Content="Set pressure 1" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallOrangeButton}" Click="Adv_Cell_SetPres1Btn_Click"/>
                                        <Label   Grid.Row="0" Grid.Column="2" x:Name="Adv_Cell_SetPres1OutLbl" Content="-"/>

                                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="Adv_Cell_SetPres2InTxt" Text="30.0" Style="{StaticResource SmallTextBox}"/>
                                        <Button  Grid.Row="1" Grid.Column="1" x:Name="Adv_Cell_SetPres2Btn" Content="Set pressure 2" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallOrangeButton}" Click="Adv_Cell_SetPres2Btn_Click"/>
                                        <Label   Grid.Row="1" Grid.Column="2" x:Name="Adv_Cell_SetPres2OutLbl" Content="-"/>

                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Shot Volume Measurment">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <StackPanel 
                                            Orientation="Vertical"
                                            Grid.Row="0" 
                                            Grid.Column="0" 
                                            Grid.ColumnSpan="3"
                                            Margin="0,0,0,8">

                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="This will open a valve and trigger the flow sensor to measure the dispensed volume." TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="Adv_Cell_Shot1InTxt"  Text="1.0" Style="{StaticResource SmallTextBox}"/>
                                        <Button  Grid.Row="1" Grid.Column="1" x:Name="Adv_Cell_Shot1Btn" Content="Measure shot from valve 1" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_Shot1Btn_Click"/>
                                        <Label   Grid.Row="1" Grid.Column="2" x:Name="Adv_Cell_Shot1OutLbl" Content="-"/>

                                        <TextBox Grid.Row="2" Grid.Column="0" x:Name="Adv_Cell_Shot2InTxt"  Text="1.0" Style="{StaticResource SmallTextBox}"/>
                                        <Button  Grid.Row="2" Grid.Column="1" x:Name="Adv_Cell_Shot2Btn" Content="Measure shot from valve 2" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_Shot2Btn_Click"/>
                                        <Label   Grid.Row="2" Grid.Column="2" x:Name="Adv_Cell_Shot2OutLbl" Content="-"/>
                                    </Grid>


                                </GroupBox>

                                <GroupBox Header="Flow Sensors">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="1" Grid.Column="1" x:Name="Adv_Cell_SetZeroBothBtn" Content="Set Zero Shift" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_SetZeroBothBtn_Click"/>
                                        <Label  Grid.Row="1" Grid.Column="2" x:Name="Adv_Cell_SetZeroBothLbl" Content="-"/>

                                        <Button Grid.Row="2" Grid.Column="1" x:Name="Adv_Cell_StartMeas1Btn" Content="Start measure 1" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_StartMeas1Btn_Click"/>
                                        <Label  Grid.Row="2" Grid.Column="2" x:Name="Adv_Cell_StartMeas1OutLbl" Content="-"/>

                                        <Button Grid.Row="3" Grid.Column="1" x:Name="Adv_Cell_StopMeas1Btn" Content="Stop measure 1" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallRedButton}" Click="Adv_Cell_StopMeas1Btn_Click"/>
                                        <Label  Grid.Row="3" Grid.Column="2" x:Name="Adv_Cell_StopMeas1OutLbl" Content="-"/>

                                        <Button Grid.Row="4" Grid.Column="1" x:Name="Adv_Cell_StartMeas2Btn" Content="Start measure 2" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallGreenButton}" Click="Adv_Cell_StartMeas2Btn_Click"/>
                                        <Label  Grid.Row="4" Grid.Column="2" x:Name="Adv_Cell_StartMeas2OutLbl" Content="-"/>

                                        <Button Grid.Row="5" Grid.Column="1" x:Name="Adv_Cell_StopMeas2Btn" Content="Stop measure 2" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallRedButton}" Click="Adv_Cell_StopMeas2Btn_Click"/>
                                        <Label  Grid.Row="5" Grid.Column="2" x:Name="Adv_Cell_StopMeas2OutLbl" Content="-"/>


                                    </Grid>
                                </GroupBox>

                            </StackPanel>
                        </ScrollViewer>

                    </TabItem>

                    <TabItem Header="Dispense" Visibility="Collapsed">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">

                                <GroupBox Header="Dispense Process">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <StackPanel 
                                            Orientation="Vertical"
                                            Grid.Row="0" 
                                            Grid.Column="0" 
                                            Grid.ColumnSpan="3"
                                            Margin="0,0,0,8">

                                            <TextBlock TextWrapping="Wrap" Text="This will do the following:"/>
                                            <TextBlock TextWrapping="Wrap" Text="1. Move to ID position and dispense shot"/>
                                            <TextBlock TextWrapping="Wrap" Text="2. Move to OD position and dispense shot"/>

                                        </StackPanel>

                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="Adv_Cell_DispShotsInLbl" Content="-"/>

                                        <Button Grid.Row="2" Grid.Column="0" x:Name="Adv_Cell_DispShotsBtn" Content="Dispense shots" IsEnabled="{Binding IsRobotControlEnabled}" Style="{DynamicResource SmallBlackButton}" Click="Adv_Cell_DispShotsBtn_Click"/>
                                        <Label Grid.Row="2" Grid.Column="1" x:Name="Adv_Cell_DispShotsOutLbl" Content="-"/>

                                    </Grid>


                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                    </TabItem>

                </TabControl>
            </GroupBox>
        </Grid>

    </Grid>
</UserControl>