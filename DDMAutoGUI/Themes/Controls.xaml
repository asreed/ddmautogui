<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TextBoxBlueLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBlue}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource TextBoxBlueDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="MonoTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontMono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SmallTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="3"/>
    </Style>

    <!-- GroupBox -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource GroupBoxHeaderText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GroupBoxOutline}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Margin" Value="3,0,3,3"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <Style TargetType="GroupBox" x:Key="WarningBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRed}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="3,0,3,3"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <!-- TabItem (default) -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="10,3,10,3"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="3,3,3,3"/>
    </Style>

    <!-- NOTE: This implicit ProgressBar style intentionally starts Collapsed and
         Indeterminate (existing app behavior). Consider moving these to a keyed
         "BusyBar" style later so a plain <ProgressBar> is visible by default. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Height" Value="5"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#AAA"/>
    </Style>

    <Style TargetType="ProgressBar" x:Key="ProgressMain">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#AAA"/>
    </Style>

    <Style TargetType="ProgressBar" x:Key="ProgressMainBusy">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#AAA"/>
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource TextBoxBlueLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBlue}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource TextBoxBlueDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeView -->
    <Style TargetType="TreeView">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Background" Value="{StaticResource TextBoxBlueLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBlue}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Main navigation tabs -->
    <Style TargetType="TabItem" x:Key="MainTab">
        <Setter Property="Width" Value="130"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="mainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Cursor="Hand"
                                BorderThickness="1,1,1,1"
                                CornerRadius="0"
                                Padding="12"
                                Margin="4,0,-1,-1">
                            <StackPanel x:Name="mainPanel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                <Image Width="18"
                                       Height="18"
                                       Margin="0,0,8,0"
                                       Source="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Tag}"/>
                                <ContentPresenter x:Name="mainLabel" ContentSource="Header">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,1,0,0"/>
                                            <!--<Setter Property="FontWeight" Value="Bold"/>-->
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White" />
                            <Setter TargetName="mainBorder" Property="BorderThickness" Value="1,1,0,1"/>
                            <Setter TargetName="mainBorder" Property="Padding" Value="16"/>
                            <Setter TargetName="mainBorder" Property="Margin" Value="0,-2,-1,-3"/>
                            <Setter TargetName="mainLabel" Property="Panel.ZIndex" Value="100"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="mainLabel" Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter Property="Background" Value="#fff" />-->
                            <!--<Setter Property="BorderBrush" Value="{StaticResource TextBoxBlue}" />-->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="mainPanel" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="No"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="mainBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Margin="0,1"
                            Padding="10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid>
                                <Ellipse x:Name="outerCircle"
                                         Width="16"
                                         Height="16"
                                         Fill="{TemplateBinding Background}"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="1"/>
                                <Ellipse x:Name="innerCircle"
                                         Width="11"
                                         Height="11"
                                         StrokeThickness="0"
                                         Fill="Transparent"/>
                            </Grid>
                            <TextBlock x:Name="displayText"
                                       Foreground="Black"
                                       Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="innerCircle" Property="Fill" Value="#000" />
                            <Setter TargetName="mainBorder" Property="Background" Value="{StaticResource TextBoxBlueLight}"/>
                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="{StaticResource TextBoxBlue}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TextBoxBlueLight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="displayText" Property="Foreground" Value="#CCC"/>
                            <Setter TargetName="outerCircle" Property="Stroke" Value="#CCC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result borders -->
    <Style x:Key="PassBorder" TargetType="Border">
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Background" Value="{StaticResource PrimaryGreen}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenDark}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="14"/>
                <!--<Setter Property="FontWeight" Value="Bold"/>-->
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="FailBorder" TargetType="Border" BasedOn="{StaticResource PassBorder}">
        <Setter Property="Background" Value="{StaticResource PrimaryRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRedDark}"/>
    </Style>

    <Style x:Key="IncompleteBorder" TargetType="Border" BasedOn="{StaticResource PassBorder}">
        <Setter Property="Background" Value="LightGray"/>
        <Setter Property="BorderBrush" Value="DarkGray"/>
    </Style>

    <!-- Alert / warning bars -->
    <Style x:Key="AlertBar" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRedDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource PrimaryRed}"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="WarningBar" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryOrangeDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource PrimaryOrange}"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="StatusBarBottom" TargetType="Grid">
        <Setter Property="Margin" Value="-4,0,-4,-4"/>
        <Setter Property="Height" Value="36"/>
        <!--<Setter Property="Background" Value="WhiteSmoke"/>-->
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#222"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="SimBorder" TargetType="Border">
        <Setter Property="Background" Value="#FFF9F230"/>
        <Setter Property="BorderBrush" Value="#FFCCC50A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="ReadoutLabel" TargetType="Label">
        <Setter Property="Padding" Value="5,2,5,2"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="WhiteSmoke"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ReadoutsEnabled}" Value="False">
                <Setter Property="Foreground" Value="#FFAAAAAA"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>