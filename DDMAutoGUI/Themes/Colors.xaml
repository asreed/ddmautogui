<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="AppFontMono">Consolas</FontFamily>

    <!-- NOTE: BrooksBlue duplicates PrimaryBlue (#FF0072BC). Kept to avoid breaking
         any external references; prefer PrimaryBlue going forward. -->
    <SolidColorBrush x:Key="BrooksBlue" Color="#FF0072BC"/>

    <!-- Gradients (identity Scale/Skew/Rotate/Translate transforms removed; they had no effect) -->
    <LinearGradientBrush x:Key="GrayGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFEDEDED" Offset="0"/>
        <GradientStop Color="#FFE6E6E6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF1288D4" Offset="0"/>
        <GradientStop Color="#FF00609E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF34B330" Offset="0"/>
        <GradientStop Color="#FF21921E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrangeGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFDCAD2E" Offset="0"/>
        <GradientStop Color="#FFC59821" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFD62828" Offset="0"/>
        <GradientStop Color="#FFB71F1F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Only AngleWhiteGradient uses a meaningful transform (45 deg rot) -->
    <LinearGradientBrush x:Key="AngleWhiteGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <LinearGradientBrush.RelativeTransform>
            <RotateTransform Angle="-45" CenterX="0.5" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>

    <!-- Blue -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="#FF0072BC"/>
    <SolidColorBrush x:Key="PrimaryBlueLight" Color="#FF57BEFF"/>
    <SolidColorBrush x:Key="PrimaryBlueDark" Color="#FF004573"/>
    <SolidColorBrush x:Key="PrimaryBlueDarkDark" Color="#FF003C65"/>

    <!-- Green -->
    <SolidColorBrush x:Key="PrimaryGreen" Color="#FF34B330"/>
    <SolidColorBrush x:Key="PrimaryGreenLight" Color="#FF77FF73"/>
    <SolidColorBrush x:Key="PrimaryGreenDark" Color="#FF12670F"/>
    <SolidColorBrush x:Key="PrimaryGreenDarkDark" Color="#FF062505"/>

    <!-- Orange -->
    <SolidColorBrush x:Key="PrimaryOrange" Color="#FFDCAD2E"/>
    <SolidColorBrush x:Key="PrimaryOrangeLight" Color="#FFFFDC7C"/>
    <SolidColorBrush x:Key="PrimaryOrangeDark" Color="#FFA57B0A"/>
    <SolidColorBrush x:Key="PrimaryOrangeDarkDark" Color="#FF3E2E03"/>

    <!-- Red -->
    <SolidColorBrush x:Key="PrimaryRed" Color="#D62828"/>
    <SolidColorBrush x:Key="PrimaryRedLight" Color="#FFFF9191"/>
    <SolidColorBrush x:Key="PrimaryRedDark" Color="#9B1C1C"/>
    <SolidColorBrush x:Key="PrimaryRedDarkDark" Color="#FF420606"/>

    <!-- Neutrals -->
    <SolidColorBrush x:Key="DisabledGreyBg" Color="#FFE6E6E6"/>
    <SolidColorBrush x:Key="DisabledGreyText" Color="#FFB3B3B3"/>

    <SolidColorBrush x:Key="GroupBoxHeaderText" Color="#FFB7B7B7"/>
    <SolidColorBrush x:Key="GroupBoxOutline" Color="#FFE6E6E6"/>

    <SolidColorBrush x:Key="TextBoxBlueLight" Color="#FFF7FAFF"/>
    <SolidColorBrush x:Key="TextBoxBlue" Color="#FF93ADEF"/>
    <SolidColorBrush x:Key="TextBoxBlueDark" Color="#FF0C2B9A"/>

</ResourceDictionary>