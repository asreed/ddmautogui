<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================= -->
    <!-- Default (gray) button. Kept as its own template because its    -->
    <!-- highlight/shadow opacities and disabled colors differ from the -->
    <!-- accent buttons.                                                -->
    <!-- ============================================================= -->
    <Style TargetType="{x:Type Button}">
        <Style.Resources>
            <Style TargetType="Image">
                <Setter Property="Height" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </Style.Resources>

        <Setter Property="Background" Value="{StaticResource GrayGradient}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#333"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="mainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="Auto"
                                              Height="Auto"/>
                        </Border>
                        <Border x:Name="highlightBorder"
                                Background="Transparent"
                                BorderBrush="{StaticResource AngleWhiteGradient}"
                                BorderThickness="1,1,0,0"
                                CornerRadius="6"
                                Opacity="1"
                                Margin="2"/>
                        <Border x:Name="shadowBorder"
                                Background="Transparent"
                                BorderBrush="Black"
                                BorderThickness="0,0,2,2"
                                CornerRadius="8"
                                Opacity="0.4"
                                Margin="0"/>
                        <Border x:Name="shadowBorderFill"
                                Background="Transparent"
                                BorderBrush="Black"
                                BorderThickness="0,0,4,4"
                                CornerRadius="8"
                                Opacity="0.1"
                                Margin="0,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="mainBorder" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="mainBorder" Property="Background" Value="#ccc"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#999"/>
                            <Setter TargetName="mainBorder" Property="Background" Value="WhiteSmoke"/>
                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="#aaa"/>
                            <Setter TargetName="highlightBorder" Property="Opacity" Value="0"/>
                            <Setter TargetName="shadowBorder" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="shadowBorder" Property="Opacity" Value="0.1"/>
                            <Setter TargetName="shadowBorderFill" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SmallButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- Flat icon button -->
    <Style TargetType="{x:Type Button}" x:Key="SmallDevIconButton">
        <Style.Resources>
            <Style TargetType="Image">
                <Setter Property="Height" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </Style.Resources>

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="#99000000"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="mainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="Auto"
                                              Height="Auto"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="mainBorder" Property="Background" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="mainBorder" Property="Background" Value="#aaFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!-- Shared accent-button template + base style.                    -->
    <!-- mainBorder.Background uses TemplateBinding, so per-color hover  -->
    <!-- / pressed colors live in each style's Style.Triggers (a         -->
    <!-- Setter.Value can't be a Binding, but a style trigger changing   -->
    <!-- Background flows through the TemplateBinding).                  -->
    <!-- ============================================================= -->
    <ControlTemplate x:Key="AccentButtonTemplate" TargetType="Button">
        <Grid>
            <Border x:Name="mainBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    Margin="0"
                    CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="Auto"
                                  Height="Auto"/>
            </Border>
            <Border x:Name="highlightBorder"
                    Background="Transparent"
                    BorderBrush="{StaticResource AngleWhiteGradient}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="6"
                    Opacity="0.5"
                    Margin="2"/>
            <Border x:Name="shadowBorder"
                    Background="Transparent"
                    BorderBrush="Black"
                    BorderThickness="0,0,2,2"
                    CornerRadius="8"
                    Opacity="0.4"
                    Margin="0"/>
            <Border x:Name="shadowBorderFill"
                    Background="Transparent"
                    BorderBrush="Black"
                    BorderThickness="0,0,4,4"
                    CornerRadius="8"
                    Opacity="0.2"
                    Margin="0,0,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="highlightBorder" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="shadowBorder" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="shadowBorderFill" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="shadowBorder" Property="Opacity" Value="0.1"/>
                <Setter TargetName="shadowBorderFill" Property="Opacity" Value="0.05"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="mainBorder" Property="Background" Value="{StaticResource DisabledGreyBg}"/>
                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{StaticResource DisabledGreyText}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledGreyText}"/>
                <Setter TargetName="highlightBorder" Property="Opacity" Value="0"/>
                <Setter TargetName="shadowBorder" Property="BorderBrush" Value="White"/>
                <Setter TargetName="shadowBorder" Property="Opacity" Value="0.1"/>
                <Setter TargetName="shadowBorderFill" Property="Opacity" Value="0"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AccentButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}"/>
    </Style>

    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource AccentButtonBase}">
        <Style.Resources>
            <Style TargetType="Image">
                <Setter Property="Height" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource BlueGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueDarkDark}"/>
        <Setter Property="Padding" Value="20,12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBlueDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

