        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Padding" Value="20,12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF525252"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="Black"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small accent variants -->
    <Style x:Key="SmallGreenButton" TargetType="Button" BasedOn="{StaticResource GreenButton}">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <Style x:Key="SmallOrangeButton" TargetType="Button" BasedOn="{StaticResource OrangeButton}">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <Style x:Key="SmallRedButton" TargetType="Button" BasedOn="{StaticResource RedButton}">
        <Setter Property="Padding" Value="4"/>
